<% layout("/layouts/boilerplate") %>
<div class="auth-wrapper">
  <div class="auth-visual">
    <div class="auth-visual-text">
      <h2>Welcome back, roamer.</h2>
      <p>Sign in to manage your listings, leave reviews, and pick up where you left off.</p>
    </div>
  </div>
  <div class="auth-form-side">
    <div class="auth-form-inner">
      <a class="wl-brand" href="/listings"><i class="fa-regular fa-compass"></i> Roamly</a>
      <h3>Login</h3>
      <p class="auth-subtext">Enter your details to access your account.</p>
      <form action="/login" method="post" class="needs-validation" novalidate>
        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <input type="text" name="username" id="username" class="form-control" required>
        </div>
        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input type="password" name="password" id="password" class="form-control" required>
        </div>
        <button class="btn btn-primary-wl">Login</button>
      </form>
      <p class="auth-switch">New to Roamly? <a href="/signup">Create an account</a></p>
    </div>
  </div>
</div>