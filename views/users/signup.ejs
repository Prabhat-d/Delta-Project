<% layout("/layouts/boilerplate") %>

  <div class="auth-wrapper">
    <div class="auth-visual">
      <div class="auth-visual-text">
        <h2>Your next stay starts here.</h2>
        <p>Join Roamly to book unique homes and share your own space with travelers.</p>
      </div>
    </div>
    <div class="auth-form-side">
      <div class="auth-form-inner">
        <a class="wl-brand" href="/listings"><i class="fa-regular fa-compass"></i> Roamly</a>
        <h3>Create account</h3>
        <p class="auth-subtext">It only takes a minute to get started.</p>
        <form action="/signup" method="post" class="needs-validation" novalidate>
          <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input type="text" name="username" id="username" class="form-control" required>
            <div class="valid-feedback">Looks good!</div>
          </div>
          <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" name="email" id="email" class="form-control" required>
          </div>
          <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input type="password" name="password" id="password" class="form-control" required>
          </div>
          <button class="btn btn-primary-wl">Signup</button>
        </form>
        <p class="auth-switch">Already have an account? <a href="/login">Log in</a></p>
      </div>
    </div>
  </div>
