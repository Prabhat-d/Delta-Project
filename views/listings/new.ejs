<% layout("/layouts/boilerplate") %>

<div class="form-shell">
  <div class="form-shell-header">
    <span class="section-eyebrow">Host on Roamly</span>
    <h3>Create a new listing</h3>
    <p>Share your space with travelers around the world.</p>
  </div>
  <div class="form-card">
    <form action="/listings" method="post" class="needs-validation" novalidate enctype="multipart/form-data">
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input type="text" name="listing[title]" placeholder="Add a catchy title" class="form-control" required>
        <div class="valid-feedback">Looks good</div>
        <div class="invalid-feedback">Please enter title</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea name="listing[description]" placeholder="Describe what makes this place special" class="form-control" rows="4" required></textarea>
        <div class="invalid-feedback">Please enter short description</div>
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Upload listing image</label>
        <input type="file" name="listing[image]" class="form-control" required>
        <div class="invalid-feedback">Please upload a listing image</div>
      </div>

      <div class="form-group-row mb-3">
        <div>
          <label for="price" class="form-label">Price per night</label>
          <input name="listing[price]" placeholder="1200" class="form-control" required>
          <div class="invalid-feedback">Price should be valid</div>
        </div>
        <div>
          <label for="country" class="form-label">Country</label>
          <input name="listing[country]" placeholder="India" type="text" class="form-control" required>
          <div class="invalid-feedback">Country name should be valid</div>
        </div>
      </div>

      <div class="mb-3">
        <label for="location" class="form-label">Location</label>
        <input name="listing[location]" placeholder="Jaipur, Rajasthan" type="text" class="form-control" required>
        <div class="invalid-feedback">Location should be valid</div>
      </div>

      <hr class="form-divider">
      <button class="btn btn-primary-wl add-btn">Create listing</button>
    </form>
  </div>
</div>