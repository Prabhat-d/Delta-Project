<% layout("/layouts/boilerplate") %>
<div class="map-card">
  <div id="map" data-coordinates="<%= listing.geometry.coordinates %>" data-title="<%= listing.title %>"></div>
</div>

<div class="container show-hero">
  <div class="show-hero-top">
    <div>
      <h1 class="show-title"><%= listing.title %></h1>
      <div class="show-meta">
        <span><%= listing.location %>, <%= listing.country %></span>
        <% if(listing.reviews.length > 0) {
               let avg = listing.reviews.reduce((s,r)=>s+r.rating,0) / listing.reviews.length; %>
        <span class="dot"></span>
        <span><i class="fa-solid fa-star"></i> <%= avg.toFixed(1) %> (<%= listing.reviews.length %> review<%= listing.reviews.length > 1 ? "s" : "" %>)</span>
        <% } %>
      </div>
    </div>
    <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
    <div class="show-owner-actions">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-wl">Edit</a>
      <button type="button" class="btn btn-danger-wl" data-bs-toggle="modal" data-bs-target="#deleteListingModal">Delete</button>
    </div>
    <% } %>
  </div>

  <div class="show-img-wrap">
    <img src="<%= listing.image.url %>" class="show-img" alt="<%= listing.title %>">
  </div>

  <div class="show-layout">
    <div class="show-main-col">
      <div class="show-host-row">
        <div class="avatar-circle avatar-lg"><%= listing.owner.username.charAt(0).toUpperCase() %></div>
        <div>
          <h5>Hosted by <%= listing.owner.username %></h5>
          <p>Usually responds within a day</p>
        </div>
      </div>

      <div class="show-description">
        <h4>About this place</h4>
        <p><%= listing.description %></p>
      </div>

      <div class="amenities-block">
        <h4>What this place offers</h4>
        <div class="amenities-grid">
          <div class="amenity-item"><i class="fa-solid fa-wifi"></i> Free Wi-Fi</div>
          <div class="amenity-item"><i class="fa-solid fa-kitchen-set"></i> Fully equipped kitchen</div>
          <div class="amenity-item"><i class="fa-solid fa-square-parking"></i> Free parking</div>
          <div class="amenity-item"><i class="fa-solid fa-snowflake"></i> Air conditioning</div>
          <div class="amenity-item"><i class="fa-solid fa-tv"></i> Television</div>
          <div class="amenity-item"><i class="fa-solid fa-shirt"></i> Washing machine</div>
        </div>
      </div>

      <div class="show-reviews">
        <div class="reviews-count-heading">
          <i class="fa-solid fa-star"></i>
          <h4 style="margin:0;">
            <% if(listing.reviews.length > 0) { %>
            <%= listing.reviews.length %> review<%= listing.reviews.length > 1 ? "s" : "" %>
            <% } else { %>
            Reviews
            <% } %>
          </h4>
        </div>

        <% if(currUser) { %>
        <div class="review-form-card">
          <h5>Leave a review</h5>
          <form action="/listings/<%= listing._id %>/reviews" method="post" class="needs-validation" novalidate>
            <div class="mb-3">
              <label class="form-label">Rating</label>
              <div class="rating-field">
                <fieldset class="starability-slot">
                  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                  <label for="first-rate1" title="Terrible">1 star</label>
                  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                  <label for="first-rate2" title="Not good">2 stars</label>
                  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                  <label for="first-rate3" title="Average">3 stars</label>
                  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                  <label for="first-rate4" title="Very good">4 stars</label>
                  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                  <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
              </div>
            </div>
            <div class="mb-3 mt-3">
              <label for="comment" class="form-label">Comment</label>
              <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control" placeholder="Share details of your experience" required></textarea>
              <div class="invalid-feedback">Please add some comment for review</div>
            </div>
            <button class="btn btn-dark-wl">Submit review</button>
          </form>
        </div>
        <% } %>

        <% if(listing.reviews.length > 0) { %>
        <div class="reviews-grid">
          <% for(review of listing.reviews) { %>
          <div class="card review-card">
            <div class="card-body">
              <div class="review-author-row">
                <div class="avatar-circle"><%= review.author.username.charAt(0).toUpperCase() %></div>
                <p class="review-author-name">@<%= review.author.username %></p>
              </div>
              <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
              <p class="card-text"><%= review.comment %></p>
              <% if(currUser && currUser._id.equals(review.author._id)) { %>
              <button type="button" class="btn btn-sm btn-danger-wl" data-bs-toggle="modal" data-bs-target="#deleteReviewModal<%= review._id %>">Delete</button>

              <div class="modal fade" id="deleteReviewModal<%= review._id %>" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                  <div class="modal-content">
                    <div class="modal-header">
                      <div>
                        <div class="modal-icon-danger"><i class="fa-solid fa-trash"></i></div>
                        <h5 class="modal-title-custom">Delete this review?</h5>
                      </div>
                    </div>
                    <div class="modal-body">This can't be undone.</div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-outline-wl" data-bs-dismiss="modal">Cancel</button>
                      <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
                        <button type="submit" class="btn btn-danger-wl" style="background-color:#C13515 !important; color:white !important; border:none !important;">Delete review</button>
                      </form>
                    </div>
                  </div>
                </div>
              </div>
              <% } %>
            </div>
          </div>
          <% } %>
        </div>
        <% } else { %>
        <div class="empty-reviews">
          <i class="fa-regular fa-comment-dots"></i>
          <p>No reviews yet. Be the first to share your experience.</p>
        </div>
        <% } %>
      </div>

      <% if(listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates[0] && listing.geometry.coordinates[1]) { %>
      <div class="show-map-block">
        <h4>Where you'll be</h4>
        <div class="map-card">
          <div id="map"></div>
        </div>
      </div>
      <% } %>
    </div>

    <div class="show-side-col">
      <div class="summary-card">
        <div class="summary-price">&#8360; <%= listing.price.toLocaleString("en-IN") %> <span>/ night</span></div>
        <% if(listing.reviews.length > 0) {
               let avg = listing.reviews.reduce((s,r)=>s+r.rating,0) / listing.reviews.length; %>
        <div class="summary-rating-row"><i class="fa-solid fa-star"></i> <%= avg.toFixed(1) %> &middot; <%= listing.reviews.length %> review<%= listing.reviews.length > 1 ? "s" : "" %></div>
        <% } %>
        <div class="summary-info-row"><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></div>
        <div class="summary-info-row"><i class="fa-solid fa-user"></i> Hosted by <%= listing.owner.username %></div>
      </div>
    </div>
  </div>
</div>
<div class="modal fade" id="deleteListingModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <div class="modal-icon-danger"><i class="fa-solid fa-trash"></i></div>
          <h5 class="modal-title-custom">Delete this listing?</h5>
        </div>
      </div>
      <div class="modal-body">
        This will permanently remove "<%= listing.title %>" along with its reviews. This can't be undone.
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-wl" data-bs-dismiss="modal">Cancel</button>
        <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
          <button type="submit" class="btn btn-danger-wl" style="background-color:#C13515 !important; color:white !important; border:none !important;">Delete listing</button>
        </form>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="deleteReviewModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <div class="modal-icon-danger"><i class="fa-solid fa-trash"></i></div>
          <h5 class="modal-title-custom">Delete this review?</h5>
        </div>
      </div>
      <div class="modal-body">This can't be undone.</div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-wl" data-bs-dismiss="modal">Cancel</button>
        <form id="deleteReviewForm" method="post">
          <button type="submit" class="btn btn-danger-wl" style="background-color:#C13515 !important; color:white !important; border:none !important;">Delete review</button>
        </form>
      </div>
    </div>
  </div>
</div>
<script src="/js/map.js"></script>